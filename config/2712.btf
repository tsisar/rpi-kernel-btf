# Appended to debian/config/arm64/rpi/config.2712 of the Raspberry Pi OS kernel
# source package (last file in the flavour's KCONFIG list, so it wins).

# BTF. DWARF is needed by pahole to encode it; it stays in the build-tree
# objects (compressed, to fit a hosted runner's disk), the installed Image only
# grows by the BTF section itself.
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_COMPRESSED_ZLIB=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# Socket diag for UDP plus SOCK_DESTROY: Cilium >= 1.20 terminates sockets of
# removed service backends through INET_DIAG and refuses to without these
# (ADR-0003). INET_DIAG is already =m in the Pi config; udp_diag autoloads on
# the first UDP diag request.
CONFIG_INET_UDP_DIAG=m
CONFIG_INET_DIAG_DESTROY=y
